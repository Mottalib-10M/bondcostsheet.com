---
/**
 * A bond in one state: the calculator set on the type and state, the folded answer, the state's own text
 * (src/content/states/<bond>/<slug>.ts), then the rule as read: amount, term, statute, the quoted line and its page.
 * The tables are generated, so they carry data-chrome; the prose of the content file is what makes the page.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import { route, ROUTES } from '../i18n/routes';
import { label } from '../i18n/nav';
import { t } from '../i18n/ui';
import { guideById, statePageById, stateId, hubOf } from '../lib/pages';
import { helpers, table, ext } from '../lib/helpers';
import { KIT as K } from '../lib/kit';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { StateDef } from '../lib/page-types';
interface Props { def: StateDef }
const { def } = Astro.props;
const lang = 'en';
const ui = t(lang);
const ty = K.T(def.bond);
const r = K.R(def.bond, def.slug);
const id = stateId(def.bond, def.slug);
const path = route(id, lang);
const hub = hubOf(def.bond)!;
const h1 = def.h1 ?? `${ty.short} bond in ${r.name}: amount and cost`;
const jsonLd = [webApplicationSchema({ name: h1, description: def.description, path, lang }), articleSchema({ title: h1, description: def.description, path, lang }), webPageSchema({ name: h1, description: def.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: hub.nav, path: route(hub.id, lang) }, { name: r.name, path }])];
if (def.faqs.length) jsonLd.push(faqSchema(def.faqs, lang));
const card = (x: string) => guideById(x)?.card ?? (statePageById(x) ? statePageById(x)!.intro : '');
const related = def.related.filter((x) => ROUTES.some((q) => q.id === x)).map((x) => ({ href: route(x, lang), name: label(x), description: card(x) }));
const amountRows: Array<[string, string]> = r.range ? [['Bond amount', `${K.usd(r.range[0])} to ${K.usd(r.range[1])}, set by the board for each license`]] : r.multiplier ? [['Bond amount', `${K.dec(r.multiplier, 1)} × the vehicle value`]] : r.variants.length ? r.variants.map((v) => [v.label, v.amount ? K.usd(v.amount) : 'no bond']) : [['Bond amount', r.required && r.amount ? K.usd(r.amount) : 'not required']];
const factRows: Array<[string, string]> = [
  ...amountRows,
  ...(r.previous ? [[`Amount before ${r.changed ? K.day(r.changed) : 'the change'}`, K.usd(r.previous)] as [string, string]] : []),
  ...(r.term ? [['Term', `${K.num(r.term)} year${r.term > 1 ? 's' : ''}`] as [string, string]] : []),
  ...(r.valueBasis ? [['Value used', r.valueBasis] as [string, string]] : []),
  ...(r.threshold ? [['Bond needed from', `${K.usd(r.threshold)} of vehicle value`] as [string, string]] : []),
  ['Rule', r.statute ?? 'agency rule'],
  ['Line read', `“${r.quote.replace(/\s*[–—]\s*/g, ': ')}”`],
  ['Page', ext(r.url, new URL(r.url).hostname)],
  ['Read on', K.day(r.read)],
];
const sources = [{ name: `${r.name}: ${ty.label.toLowerCase()} rule (${r.statute ?? 'official page'})`, url: r.url }, ...(r.official ? [{ name: `${r.name}: published bond price`, url: r.official.url }] : [])].filter((x, i, a) => a.findIndex((y) => y.url === x.url) === i);
---
<PageLayout title={def.title} description={def.description} lang={lang} jsonLd={jsonLd} faqs={def.faqs} related={related} sources={sources} breadcrumbs={[{ label: hub.nav, href: route(hub.id, lang) }, { label: r.name }]}>
  <article>
    <header class="mb-4">
      <h1 class="font-serif text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{h1}</h1>
      <p class="mt-2 text-base text-navy-700 sm:text-lg">{def.intro}</p>
    </header>
    <div data-outil data-chrome class="mb-4"><Tool kind="bond" arg={{ bt: def.bond, lock: 1, st: def.slug, ...(def.toolArg ?? {}) }} idPrefix={`s-${def.bond}-${r.code.toLowerCase()}`} /></div>
    <p class="mb-6 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('method', lang)} class="underline hover:text-navy-900">{label('method')}</a> · rule read {K.day(r.read)}</p>
    <Clamp text={def.resume} lang={lang} id={`clamp-${def.bond}-${def.slug}`} class="mb-8" />
    <Body html={def.body(helpers())} path={path} />
    <section data-chrome class="mt-10">
      <h2 class="font-serif text-2xl font-bold text-navy-900">The {r.name} rule as read</h2>
      <Fragment set:html={table(['Item', 'Value'], factRows, `${r.note}`, ['l', 'l'])} />
    </section>
  </article>
</PageLayout>
