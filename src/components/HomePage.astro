---
/**
 * Home (the pillar): the bond calculator first (bond x state x credit), the folded answer, a ledger of the
 * amounts the law sets (state bonds and federal bonds), the explanation in prose, then the state pages.
 * Text: src/content/home.ts. Generated blocks carry data-chrome.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import { HOME, VALUE } from '../content/home';
import { route } from '../i18n/routes';
import { helpers, SOURCES } from '../lib/helpers';
import { STATE_PAGES, stateId, hubOf, guideById } from '../lib/pages';
import { KIT as K } from '../lib/kit';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { LAST_UPDATED } from '../data/site-config';
const lang = 'en';
const x = HOME;
const path = route('home', lang);
const h = helpers();
const sources = x.sources.map((k) => ({ name: SOURCES[k].label, url: SOURCES[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const amounts = (t: string) => K.states(t).filter((r) => r.required).map((r) => K.amt(t, r.slug)).filter((a) => a > 0);
const ledger = K.TYPES.filter((t) => t.id !== 'title').map((t) => { const a = amounts(t.id); return { t, hub: hubOf(t.id), n: K.states(t.id).length, lo: Math.min(...a), hi: Math.max(...a), med: K.median(a) }; });
const feds = [
  { id: 'freight-bond', g: 'freight-broker-bond', what: 'Freight broker (BMC-84)', amt: K.usd(K.F('freight-broker').amount) },
  { id: 'erisa', g: 'erisa-bond', what: 'ERISA plan official', amt: `10 % of funds, ${K.usd(K.F('erisa').min)} to ${K.usd(K.F('erisa').max)}` },
  { id: 'miller', g: 'performance-bond', what: 'Federal construction over ' + K.usd(K.F('miller-act').threshold), amt: '100 % performance + 100 % payment' },
  { id: 'bid', g: 'bid-bond', what: 'Federal bid guarantee', amt: `20 % of the bid, up to ${K.usd(K.F('bid-guarantee').cap)}` },
];
const byType = [...new Set(STATE_PAGES.map((p) => p.bond))].map((b) => ({ b, hub: hubOf(b), pages: STATE_PAGES.filter((p) => p.bond === b) }));
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-4">
    <h1 class="font-serif text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">{x.intro}</p>
  </header>
  <div data-outil data-chrome><Tool kind="bond" idPrefix="home" /></div>
  <p class="mt-3 text-sm text-navy-600">Amounts read on statutes, agencies and DMVs · premiums are estimates with their method · no form, no quote request · <a href={route('method', lang)} class="underline">Method</a> · <a href={route('about', lang)} class="underline">Publisher</a> · data of <time datetime={LAST_UPDATED}>{K.day(LAST_UPDATED)}</time></p>
  <p class="mt-3 text-navy-800">{VALUE}</p>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="my-8" />
  <section data-chrome class="mt-8">
    <h2 class="font-serif text-2xl font-bold text-navy-900">The amount the law sets, before any price</h2>
    <div class="not-prose mt-4 overflow-x-auto">
      <table class="journal w-full text-sm">
        <thead><tr><th scope="col" class="px-3 py-2 text-left">State bond</th><th scope="col" class="px-3 py-2 text-right">States read</th><th scope="col" class="px-3 py-2 text-right">Lowest</th><th scope="col" class="px-3 py-2 text-right">Median</th><th scope="col" class="px-3 py-2 text-right">Highest</th></tr></thead>
        <tbody>
          {ledger.map(({ t, hub, n, lo, hi, med }) => (
            <tr><td class="border-b border-navy-100 px-3 py-2">{hub ? <a href={route(hub.id, lang)} class="text-accent-700 underline-offset-2 hover:underline">{t.label}</a> : t.label}</td><td class="tabular-nums border-b border-navy-100 px-3 py-2 text-right">{n}</td><td class="tabular-nums border-b border-navy-100 px-3 py-2 text-right">{K.usd(lo)}</td><td class="tabular-nums border-b border-navy-100 px-3 py-2 text-right font-semibold">{K.usd(med)}</td><td class="tabular-nums border-b border-navy-100 px-3 py-2 text-right">{K.usd(hi)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2">
      {feds.map((f) => (
        <li class="rounded-md border-l-4 border-accent-600 bg-white px-4 py-3">
          <p class="text-sm text-navy-600">{guideById(f.g) ? <a href={route(f.g, lang)} class="text-accent-700 hover:underline">{f.what}</a> : f.what}</p>
          <p class="mt-1 font-semibold text-navy-900">{f.amt}</p>
        </li>
      ))}
    </ul>
  </section>
  <section class="mt-8"><Body html={x.why(h)} path={path} /></section>
  <section class="mt-10" data-chrome>
    <h2 class="font-serif text-xl font-bold text-navy-900">State pages, rule read on the official site</h2>
    {byType.map(({ b, hub, pages }) => (
      <p class="mt-3 text-sm"><span class="font-semibold text-navy-800">{K.T(b).label}:</span> {pages.map((p, i) => <>{i > 0 && ' · '}<a href={route(stateId(b, p.slug), lang)} class="text-accent-700 underline-offset-2 hover:underline">{K.stateName(p.slug)}</a></>)}{hub && <> · <a href={route(hub.id, lang)} class="text-navy-700 underline">every state read</a></>}</p>
    ))}
  </section>
</PageLayout>
