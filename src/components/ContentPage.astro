---
/** A bond hub or a topic page: H1, one-line answer, the calculator at once, the folded answer, the body,
 *  then (hub) the ledger of every state read, FAQ, sources. */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import { route, ROUTES } from '../i18n/routes';
import { label, GROUPS } from '../i18n/nav';
import { t } from '../i18n/ui';
import { guideById, statePageById, STATE_PAGES, stateId } from '../lib/pages';
import { helpers, SOURCES, table, ext } from '../lib/helpers';
import { KIT as K } from '../lib/kit';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { GuideDef } from '../lib/page-types';
interface Props { page: GuideDef }
const { page } = Astro.props;
const lang = 'en';
const ui = t(lang);
const path = route(page.id, lang);
const group = GROUPS.find((g) => g.id === page.group)!;
const jsonLd = [webApplicationSchema({ name: page.h1, description: page.description, path, lang }), articleSchema({ title: page.h1, description: page.description, path, lang }), webPageSchema({ name: page.h1, description: page.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: page.nav, path }])];
if (page.faqs.length) jsonLd.push(faqSchema(page.faqs, lang));
const card = (id: string) => guideById(id)?.card ?? (statePageById(id) ? statePageById(id)!.intro : '');
const related = page.related.filter((id) => ROUTES.some((r) => r.id === id)).map((id) => ({ href: route(id, lang), name: label(id), description: card(id) }));
const b = page.bond;
const recs = b ? K.states(b) : [];
const hasPage = (slug: string) => b && STATE_PAGES.some((p) => p.bond === b && p.slug === slug);
const amtText = (r: (typeof recs)[number]) => r.range ? `${K.usd(r.range[0])} to ${K.usd(r.range[1])}, set by the board` : r.multiplier ? `${K.dec(r.multiplier, 1)} × the vehicle value` : r.variants.length > 1 ? r.variants.map((v) => `${v.label}: ${K.usd(v.amount)}`).join('<br>') : !r.required && !r.variants.length ? 'not required' : K.usd(K.amt(b!, r.slug));
const rows = recs.map((r) => [hasPage(r.slug) ? `<a href="${route(stateId(b!, r.slug), lang)}">${r.name}</a>` : r.name, amtText(r), r.previous ? `${K.usd(r.previous)}${r.changed ? ` until ${K.day(r.changed)}` : ''}` : '', r.statute ?? '', ext(r.url, 'read')]);
const sources = [...page.sources.map((k) => ({ name: SOURCES[k].label, url: SOURCES[k].url })), ...recs.map((r) => ({ name: `${r.name}: ${K.T(b!).label.toLowerCase()} rule`, url: r.url }))].filter((x, i, a) => a.findIndex((y) => y.url === x.url) === i);
---
<PageLayout title={page.title} description={page.description} lang={lang} jsonLd={jsonLd} faqs={page.faqs} related={related} sources={sources} breadcrumbs={[{ label: group.label }, { label: page.nav }]}>
  <article>
    <header class="mb-4">
      <h1 class="font-serif text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{page.h1}</h1>
      <p class="mt-2 text-base text-navy-700 sm:text-lg">{page.intro}</p>
    </header>
    <div data-outil data-chrome class="mb-4"><Tool kind={page.tool} arg={page.toolArg} idPrefix={`p${page.order}`} /></div>
    <p class="mb-6 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('method', lang)} class="underline hover:text-navy-900">{label('method')}</a> · rules read {K.day(K.RETRIEVED)}</p>
    <Clamp text={page.resume} lang={lang} id={`clamp-${page.id}`} class="mb-8" />
    <Body html={page.body(helpers())} path={path} />
    {b && (
      <section data-chrome class="mt-10">
        <h2 class="font-serif text-2xl font-bold text-navy-900">{K.T(b).label}: the {recs.length} states read on an official page</h2>
        <Fragment set:html={table(['State', 'Bond required', 'Previous amount', 'Rule', 'Source'], rows, `Each amount quoted from the statute, the agency or the DMV page linked, read in October 2026. A state missing from this table has not been verified yet.`, ['l', 'r', 'r', 'l', 'l'])} />
      </section>
    )}
  </article>
</PageLayout>
