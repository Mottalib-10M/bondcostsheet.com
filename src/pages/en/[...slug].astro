---
/** Every bond or topic page (src/content/guides) and every bond-in-a-state page (src/content/states). */
import ContentPage from '../../components/ContentPage.astro';
import StatePage from '../../components/StatePage.astro';
import { GUIDES, STATE_PAGES } from '../../lib/pages';
import { stateSlugPath } from '../../i18n/routes';
export function getStaticPaths() {
  return [
    ...GUIDES.map((page) => ({ params: { slug: page.slug }, props: { kind: 'g', def: page } })),
    ...STATE_PAGES.map((def) => ({ params: { slug: stateSlugPath(def.bond, def.slug) }, props: { kind: 's', def } })),
  ];
}
const { kind, def } = Astro.props as { kind: 'g' | 's'; def: any };
---
{kind === 'g' ? <ContentPage page={def} /> : <StatePage def={def} />}
